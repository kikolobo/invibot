# Neon pooled connection string. Use the *pooled* endpoint (-pooler) for the app;
# drizzle-kit migrate works against either.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/invibot?sslmode=require"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# WhatsApp Cloud API. Two numbers stay configured at once and one is selected:
#   test        Meta's test number — allow-listed recipients only, no cost
#   production  the live number — reaches anybody, bills every conversation
# Unset means test, so an environment that forgets cannot spend money.
#
# Phone Number ID and WABA ID are on the app's API Setup page. They are
# per-number: the two profiles sit on different WABAs, and a template approved
# on one does not exist on the other.
WHATSAPP_PROFILE="test"
WHATSAPP_TEST_PHONE_NUMBER_ID=""
WHATSAPP_TEST_WABA_ID=""
WHATSAPP_PROD_PHONE_NUMBER_ID=""
WHATSAPP_PROD_WABA_ID=""

# The number as a person dials it, digits only. Not used for sending — Graph
# addresses a number by its id — but a wa.me link cannot be built from an id,
# and auto-registro hands one to guests.
WHATSAPP_TEST_DISPLAY_PHONE=""
WHATSAPP_PROD_DISPLAY_PHONE=""

# Shared across both: one Meta app, and one system user holding both WABAs.
# The app secret is under Settings > Basic. The verify token is ours to invent —
# generate with `openssl rand -hex 24` and paste the same value into Meta's
# webhook configuration. WHATSAPP_BUSINESS_ID is the Business Portfolio, which
# is a different thing from a WABA id.
WHATSAPP_BUSINESS_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Per-profile token overrides. Only needed if one system user stops covering
# both WABAs; otherwise leave them out and WHATSAPP_ACCESS_TOKEN serves both.
# WHATSAPP_TEST_ACCESS_TOKEN=""
# WHATSAPP_PROD_ACCESS_TOKEN=""

# Cloudflare R2 — private storage for uploaded invitation cards. The bucket must
# NOT be public: WhatsApp receives the bytes through Meta's media endpoint, and
# the organizer's preview is streamed through an authenticated route.
#
# Account ID is in the Cloudflare dashboard URL. Create the bucket, then an R2
# API token (Object Read & Write) for the key pair. Without these the upload UI
# says so and everything else keeps working.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Anthropic — the assistant that answers guests in their own words. Without it
# the rehearsal on the simulator page says so and everything else keeps working.
# Key from https://console.anthropic.com. ANTHROPIC_MODEL is optional and
# defaults to claude-opus-5; see SERVICES.md on cost per event.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
