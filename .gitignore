# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel

# Local-only record of secrets that no service will show us again. Never
# committed, never deployed — Vercel builds from git, so this never leaves the
# laptop. Not a substitute for the password manager; a second copy of things
# whose loss cannot be undone.
SECRETS.local.md

# Scratch scripts written while debugging. They are throwaway by definition;
# three of them reached a commit once.
.*.tmp.mts
